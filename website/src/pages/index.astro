---
// 全疆页面：新疆产业信息总入口
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FilterBar from '../components/FilterBar.astro';
import {
  loadArticles,
  sourceTypes,
  industryTags,
  regionsConfig,
} from '../lib/data';

const articles = loadArticles();
const latest = articles.slice(0, 6);
const allRegions = regionsConfig;
---

<BaseLayout title="新疆产业信息聚合" activeRegion="quanjang">
  <div class="container">
    <section class="hero">
      <h1>新疆产业信息聚合</h1>
      <p class="hero-desc">
        聚合新疆全域产业相关的公开信息，涵盖政策、园区、企业投资、能源矿产、交通物流与农业特色产业。
      </p>

      <div class="region-entries">
        <a class="entry entry-main" href={import.meta.env.BASE_URL}>
          <span class="entry-name">全疆</span>
          <span class="entry-desc">新疆产业信息总入口</span>
        </a>
        <a class="entry" href={`${import.meta.env.BASE_URL}nanjiang/`}>
          <span class="entry-name">南疆</span>
          <span class="entry-desc">南疆范围内产业信息</span>
        </a>
        <a class="entry" href={`${import.meta.env.BASE_URL}beijiang/`}>
          <span class="entry-name">北疆</span>
          <span class="entry-desc">北疆范围内产业信息</span>
        </a>
      </div>
    </section>

    <section class="source-types">
      <h2 class="section-title">按信息来源类型浏览</h2>
      <div class="source-grid">
        {sourceTypes.map((s) => (
          <a class="source-item" href={`${import.meta.env.BASE_URL}#source-${s.code}`}>
            {s.name}
          </a>
        ))}
      </div>
    </section>

    <section class="latest">
      <h2 class="section-title">最新产业信息</h2>
      {latest.length > 0 ? (
        <div class="article-list">
          {latest.map((a) => <ArticleCard article={a} />)}
        </div>
      ) : (
        <div class="empty">
          <p>暂无采集数据。待采集程序运行后，此处将展示最新产业信息。</p>
        </div>
      )}
    </section>

    <section class="filters">
      <h2 class="section-title">筛选与检索</h2>
      <FilterBar
        articles={articles}
        regionGroup="quanjang"
        sourceTypes={sourceTypes}
        industryTags={industryTags}
        regions={allRegions}
      />
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 40px 0 8px;
  }
  .hero h1 {
    font-size: 30px;
    margin: 0 0 12px;
  }
  .hero-desc {
    color: var(--c-text-secondary);
    max-width: 640px;
    margin: 0 0 20px;
  }
  .region-entries {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 32px;
  }
  .entry {
    display: flex;
    flex-direction: column;
    padding: 16px;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--c-text);
    background: var(--c-bg);
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .entry:hover {
    border-color: var(--c-primary);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }
  .entry-main {
    background: var(--c-primary-soft);
    border-color: var(--c-primary);
  }
  .entry-name {
    font-size: 18px;
    font-weight: 700;
  }
  .entry-desc {
    font-size: 13px;
    color: var(--c-text-muted);
  }
  .section-title {
    font-size: 20px;
    margin: 28px 0 14px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--c-primary);
    display: inline-block;
  }
  .source-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .source-item {
    padding: 8px 16px;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    font-size: 14px;
    color: var(--c-text-secondary);
    text-decoration: none;
  }
  .source-item:hover {
    border-color: var(--c-primary);
    color: var(--c-primary);
    text-decoration: none;
  }
  .article-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .empty {
    text-align: center;
    padding: 32px 0;
    color: var(--c-text-muted);
  }

  @media (max-width: 640px) {
    .region-entries {
      grid-template-columns: 1fr;
    }
  }
</style>
