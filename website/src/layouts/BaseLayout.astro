---
// 全局布局：站点导航 + 内容 + 页脚
import '../styles/global.css';
import {
  groupCounts,
  generatedAtLabel,
  sourceNameCount,
  allArticles,
} from '../lib/data';

interface Props {
  title: string;
  description?: string;
  activeRegion?: 'quanjang' | 'nanjiang' | 'beijiang' | 'article';
}

const {
  title,
  description = '聚合新疆全域产业相关的公开信息：政策、园区、企业、能源矿产、交通物流与农业特色产业。',
  activeRegion = 'quanjang',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const total = allArticles.length;

const nav = [
  { key: 'quanjang', name: '全疆', href: base, count: total },
  { key: 'nanjiang', name: '南疆', href: `${base}nanjiang/`, count: groupCounts.nanjiang ?? 0 },
  { key: 'beijiang', name: '北疆', href: `${base}beijiang/`, count: groupCounts.beijiang ?? 0 },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <!-- 主题预设：在渲染前写入，避免暗色模式闪白（纯 JS，无类型语法） -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme =
            saved === 'light' || saved === 'dark'
              ? saved
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href={base} class="brand" aria-label="新疆产业信息聚合 首页">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 17.5 8 9l4 5.5L15.5 9 21 17.5" />
              <path d="M3 20.5h18" />
            </svg>
          </span>
          <span class="brand-text">
            <span class="brand-name">新疆产业信息聚合</span>
            <span class="brand-sub">XINJIANG INDUSTRY INFO</span>
          </span>
        </a>

        <nav class="nav" aria-label="地区导航">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={['nav-link', { active: activeRegion === item.key }]}
                aria-current={activeRegion === item.key ? 'page' : undefined}
              >
                <span class="nav-name">{item.name}</span>
                <span class="nav-count">{item.count}</span>
              </a>
            ))
          }
        </nav>

        <div class="header-actions">
          <button type="button" class="theme-toggle" data-theme-toggle aria-label="切换深色模式">
            <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
              <circle cx="12" cy="12" r="4.2" />
              <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6" />
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <span class="footer-title">新疆产业信息聚合</span>
          <p class="footer-desc">
            聚合新疆全域产业相关公开信息，数据来自政府及官方机构、企业官网等公开渠道，仅供参考。
          </p>
        </div>
        <div class="footer-meta">
          <div class="footer-meta-row">
            <span class="footer-meta-label">数据更新时间</span>
            <span class="footer-meta-value">
              {generatedAtLabel ? generatedAtLabel : '更新时间未知'}
            </span>
          </div>
          <div class="footer-meta-row">
            <span class="footer-meta-label">收录信息</span>
            <span class="footer-meta-value">{total} 条 · {sourceNameCount} 个来源</span>
          </div>
          <div class="footer-meta-row">
            <span class="footer-meta-label">更新方式</span>
            <span class="footer-meta-value">每日 08:00 / 16:00 自动采集</span>
          </div>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>本站仅聚合公开信息，内容版权归原发布方所有。原文链接指向来源站点。</p>
      </div>
    </footer>

    <script>
      // 主题切换：持久化到 localStorage，并同步按钮状态
      const root = document.documentElement;
      const toggles = document.querySelectorAll<HTMLElement>('[data-theme-toggle]');

      function syncToggle() {
        const isDark = root.getAttribute('data-theme') === 'dark';
        toggles.forEach((btn) => {
          btn.setAttribute('aria-label', isDark ? '切换浅色模式' : '切换深色模式');
          btn.setAttribute('aria-pressed', String(isDark));
        });
      }

      toggles.forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch {
            /* 隐私模式下忽略存储失败 */
          }
          syncToggle();
        });
      });

      syncToggle();

      // 监听系统主题变化（用户未手动指定时跟随）
      try {
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        mq.addEventListener('change', (e) => {
          if (localStorage.getItem('theme')) return;
          root.setAttribute('data-theme', e.matches ? 'dark' : 'light');
          syncToggle();
        });
      } catch {
        /* 老浏览器忽略 */
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: 16px;
        top: -48px;
        z-index: 100;
        padding: 8px 14px;
        background: var(--c-primary-solid);
        color: #fff;
        border-radius: var(--radius);
        font-size: 13px;
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: 10px;
        text-decoration: none;
      }

      /* --- 顶栏 --- */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 40;
        background: color-mix(in srgb, var(--c-bg) 88%, transparent);
        backdrop-filter: saturate(1.6) blur(10px);
        border-bottom: 1px solid var(--c-border);
      }
      .header-inner {
        display: flex;
        align-items: center;
        gap: 28px;
        height: var(--header-h);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--c-text);
        flex: none;
      }
      .brand:hover {
        text-decoration: none;
        color: var(--c-text);
      }
      .brand-mark {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border-radius: 7px;
        background: var(--c-primary-solid);
        color: #fff;
        flex: none;
      }
      .brand-text {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
      }
      .brand-name {
        font-size: 15.5px;
        font-weight: 680;
        letter-spacing: -0.01em;
      }
      .brand-sub {
        font-size: 9.5px;
        letter-spacing: 0.12em;
        color: var(--c-text-muted);
        font-weight: 500;
      }

      /* --- 地区导航 --- */
      .nav {
        display: flex;
        align-items: center;
        gap: 2px;
        height: 100%;
      }
      .nav-link {
        position: relative;
        display: flex;
        align-items: center;
        gap: 6px;
        height: 100%;
        padding: 0 14px;
        font-size: 14.5px;
        font-weight: 550;
        color: var(--c-text-secondary);
        border-bottom: 2px solid transparent;
        transition: color 0.14s ease, border-color 0.14s ease;
      }
      .nav-link:hover {
        color: var(--c-primary);
        text-decoration: none;
      }
      .nav-link.active {
        color: var(--c-primary);
        border-bottom-color: var(--c-accent);
        font-weight: 650;
      }
      .nav-count {
        font-size: 11px;
        font-weight: 500;
        color: var(--c-text-muted);
        background: var(--c-bg-sunken);
        border-radius: 999px;
        padding: 1px 6px;
        line-height: 1.5;
      }
      .nav-link.active .nav-count {
        background: var(--c-accent-soft);
        color: var(--c-accent);
      }

      /* --- 右侧动作 --- */
      .header-actions {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .theme-toggle {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        padding: 0;
        border: 1px solid var(--c-border);
        border-radius: var(--radius);
        background: var(--c-surface);
        color: var(--c-text-secondary);
        transition: color 0.14s ease, border-color 0.14s ease, background 0.14s ease;
      }
      .theme-toggle:hover {
        color: var(--c-primary);
        border-color: var(--c-border-strong);
        background: var(--c-surface-hover);
      }
      .theme-toggle .icon-moon {
        display: none;
      }
      :root[data-theme='dark'] .theme-toggle .icon-sun {
        display: none;
      }
      :root[data-theme='dark'] .theme-toggle .icon-moon {
        display: block;
      }

      /* --- 页脚 --- */
      .site-footer {
        margin-top: 72px;
        padding: 40px 0 28px;
        border-top: 1px solid var(--c-border);
        background: var(--c-bg-soft);
      }
      .footer-inner {
        display: flex;
        gap: 40px;
        justify-content: space-between;
        flex-wrap: wrap;
      }
      .footer-brand {
        max-width: 460px;
      }
      .footer-title {
        font-size: 15px;
        font-weight: 650;
        color: var(--c-text);
      }
      .footer-desc {
        margin-top: 8px;
        font-size: 13px;
        line-height: 1.7;
        color: var(--c-text-muted);
      }
      .footer-meta {
        display: flex;
        flex-direction: column;
        gap: 8px;
        font-size: 13px;
        min-width: 220px;
      }
      .footer-meta-row {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding-bottom: 7px;
        border-bottom: 1px dashed var(--c-border);
      }
      .footer-meta-label {
        color: var(--c-text-muted);
      }
      .footer-meta-value {
        color: var(--c-text-secondary);
        font-weight: 550;
      }
      .footer-bottom {
        margin-top: 28px;
        padding-top: 16px;
        border-top: 1px solid var(--c-border);
        font-size: 12px;
        color: var(--c-text-muted);
      }

      /* --- 移动端 --- */
      @media (max-width: 720px) {
        .header-inner {
          height: auto;
          flex-wrap: wrap;
          gap: 0;
          padding-top: 10px;
        }
        .brand-mark {
          width: 28px;
          height: 28px;
        }
        .brand-name {
          font-size: 14.5px;
        }
        .brand-sub {
          display: none;
        }
        .header-actions {
          order: 2;
        }
        .theme-toggle {
          width: 32px;
          height: 32px;
        }
        .nav {
          order: 3;
          width: 100%;
          height: 44px;
          margin-top: 6px;
          border-top: 1px solid var(--c-border);
          overflow-x: auto;
          scrollbar-width: none;
        }
        .nav::-webkit-scrollbar {
          display: none;
        }
        .nav-link {
          flex: 1;
          justify-content: center;
          padding: 0 10px;
          height: 43px;
          font-size: 14px;
        }
        .site-footer {
          margin-top: 48px;
          padding: 28px 0 20px;
        }
        .footer-inner {
          gap: 24px;
        }
        .footer-meta {
          width: 100%;
        }
      }
    </style>
  </body>
</html>
