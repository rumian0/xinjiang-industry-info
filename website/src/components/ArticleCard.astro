---
// 信息卡片：服务端渲染用。视觉样式统一在 global.css 的 .article-card 系列，
// 以便客户端动态生成的卡片复用同一套样式（避免 Astro scoped 样式失效）。
import type { Article } from '../types';
import {
  sourceTypeName,
  regionName,
  industryTagName,
  formatPublished,
} from '../lib/data';

interface Props {
  article: Article;
  variant?: 'default' | 'compact';
  /** 标题链接指向站内详情页；false 时直达原文 */
  linkToDetail?: boolean;
}

const { article, variant = 'default', linkToDetail = true } = Astro.props;

const base = import.meta.env.BASE_URL;
const href = linkToDetail ? `${base}article/${article.id}/` : article.source_url;

const summary = (article.summary || '').trim();
const tags = article.industry_tags.slice(0, 3);
const restTags = Math.max(0, article.industry_tags.length - tags.length);
const published = formatPublished(article.published_at);
---

<article class:list={['article-card', { 'is-compact': variant === 'compact' }]}>
  <div class="ac-head">
    <span class="tag tag-source">{sourceTypeName(article.source_type)}</span>
    <span class="tag">{regionName(article.region)}</span>
    {article.is_test && <span class="tag tag-warn">测试数据</span>}
  </div>

  <h3 class="ac-title">
    <a href={href}>{article.title}</a>
  </h3>

  {summary && <p class="ac-summary">{summary}</p>}

  {
    tags.length > 0 && (
      <ul class="ac-tags">
        {tags.map((t) => (
          <li class="chip">{industryTagName(t)}</li>
        ))}
        {restTags > 0 && <li class="chip chip-more">+{restTags}</li>}
      </ul>
    )
  }

  <div class="ac-foot">
    <div class="ac-meta">
      <span class="ac-source">{article.source_name}</span>
      <span class="meta-dot" aria-hidden="true"></span>
      <time datetime={article.published_at ?? undefined}>{published}</time>
    </div>
    <a
      class="ac-origin"
      href={article.source_url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`在新窗口打开原文：${article.title}`}
    >
      原文
      <svg viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4.5 2H2v8h8V7.5" />
        <path d="M7 2h3v3M10 2 5.5 6.5" />
      </svg>
    </a>
  </div>
</article>
